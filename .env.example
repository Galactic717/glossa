# Copy to .env and edit. Every value below is already the default, so an empty
# .env changes nothing.

# ===========================================================================
#  The answering model
# ===========================================================================
# Glossa works out of the box with a local model and no key. Swap in any
# provider by changing the three lines under one of the blocks below.
#
# GLOSSA_PROVIDER is optional: `auto` infers the wire format from the URL
# (anthropic.com -> anthropic, a /v1 URL -> openai-compatible, else ollama).

GLOSSA_PROVIDER=auto

# --- local, default (ollama pull ornith:9b) --------------------------------
GLOSSA_BASE_URL=http://localhost:11434
GLOSSA_MODEL=ornith:9b
GLOSSA_API_KEY=

# --- OpenRouter (hundreds of models behind one key) ------------------------
# GLOSSA_BASE_URL=https://openrouter.ai/api/v1
# GLOSSA_MODEL=anthropic/claude-sonnet-5
# GLOSSA_API_KEY=sk-or-...

# --- Anthropic -------------------------------------------------------------
# GLOSSA_BASE_URL=https://api.anthropic.com
# GLOSSA_MODEL=claude-sonnet-5
# GLOSSA_API_KEY=sk-ant-...

# --- OpenAI ----------------------------------------------------------------
# GLOSSA_BASE_URL=https://api.openai.com/v1
# GLOSSA_MODEL=gpt-4o-mini
# GLOSSA_API_KEY=sk-...

# --- Groq ------------------------------------------------------------------
# GLOSSA_BASE_URL=https://api.groq.com/openai/v1
# GLOSSA_MODEL=llama-3.3-70b-versatile
# GLOSSA_API_KEY=gsk_...

# --- llama.cpp / LM Studio / vLLM (local, OpenAI-compatible) ---------------
# GLOSSA_BASE_URL=http://localhost:8080/v1
# GLOSSA_MODEL=local-model
# GLOSSA_API_KEY=

GLOSSA_TEMPERATURE=0.2
GLOSSA_MAX_TOKENS=1024
GLOSSA_TIMEOUT=300

# ===========================================================================
#  Retrieval -- always local, never sent to a provider
# ===========================================================================
GLOSSA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GLOSSA_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
GLOSSA_CHUNK_SIZE=900
GLOSSA_CHUNK_OVERLAP=150
GLOSSA_PROFILE=balanced

# ===========================================================================
#  Storage and server
# ===========================================================================
GLOSSA_DATA_DIR=./data
GLOSSA_MAX_UPLOAD_MB=50
GLOSSA_HOST=127.0.0.1
GLOSSA_PORT=8000
GLOSSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
